# Must match the REQUIRE_MFA param of the Cloud Functions (insurance-core/.env.<project>).
VITE_REQUIRE_MFA=false
# Interface language: fr or en
VITE_LANG=fr
# Firebase App Check for the customer chat page: a reCAPTCHA Enterprise site key (empty = off).
# Must go with WEBCHAT_APP_CHECK=monitor, then enforce, in ../.env.my-super-manager-app.
VITE_RECAPTCHA_SITE_KEY=
