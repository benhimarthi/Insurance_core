# Cloud Functions params for project my-super-manager-app (not secrets; secrets go in Secret Manager).
FIRESTORE_DATABASE_ID=(default)
# Modules this project deploys. auth and tenants need no secrets; conversation (web chat) needs
# GEMINI_API_KEY and PHONE_PEPPER in Secret Manager BEFORE it is deployed. The rest (app: WhatsApp,
# payment, policy, verification) needs all its secrets first, then add it (or remove this line).
ENABLED_MODULES=auth,tenants,conversation
# Gemini model used by the web chat (answers and documents)
GEMINI_MODEL=gemini-2.5-flash
# App Check on the web chat: off until the chat page has a reCAPTCHA Enterprise key, then monitor, then enforce
WEBCHAT_APP_CHECK=off
# MFA is OFF for the first test deploy. Before real data: enable Identity Platform + TOTP, set this to true,
# set VITE_REQUIRE_MFA=true in web/.env, and restore mfaOk() in firestore.rules.
REQUIRE_MFA=false
